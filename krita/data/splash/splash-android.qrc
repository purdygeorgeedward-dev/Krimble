<!DOCTYPE RCC>
<!--
  SPDX-FileCopyrightText: none
  SPDX-License-Identifier: CC0-1.0
-->
<RCC version="1.0">
    <qresource prefix="/splash">
        <!-- KRIMBLE 2026-10-06: the Krita wordmark (banner.svg) is removed from the source. The old entry was a file
             element naming it; it is not repeated here, because CMake reads this list with a plain text search and would
             still see it inside a comment (the build then stops: no rule to make that file). -->
        <!-- KRIMBLE 2026-10-02: splash images are now JPG (about 380 KB each instead of
             about 2 MB each) and the PNGs are no longer packaged. The PNG files stay in
             the repository. Original lines:
        <file alias="hd.png">logo_splash.png</file>
        <file alias="holiday.png">logo_splash_holidays.png</file>
        -->
        <!-- KRIMBLE 2026-10-19: new main splash art by George (made in Krimble; fixes the color balance and the on-screen UI
             of the old one). Same size (1536 x 1024) and same file names; the JPG is quality 88 from his PNG. -->
        <file alias="hd.jpg">logo_splash.jpg</file>
        <file alias="holiday.jpg">logo_splash_holidays.jpg</file>
    </qresource>
</RCC>

